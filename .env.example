# Copy this file to .env and fill in your values.
# .env is gitignored — NEVER commit the real .env.

# ── Flask ────────────────────────────────────────────────────────────────────
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-me-with-a-long-random-string

# ── Database ─────────────────────────────────────────────────────────────────
# Leave blank for SQLite (dev). Set to PostgreSQL URL for production.
# DATABASE_URL=postgresql://user:password@localhost:5432/tailorapp

# ── Email ────────────────────────────────────────────────────────────────────
MAIL_SERVER=localhost
MAIL_PORT=1025
MAIL_USE_TLS=false
MAIL_USE_SSL=false
MAIL_DEFAULT_SENDER=noreply@tailorapp.com

# ── Business settings ────────────────────────────────────────────────────────
BOOKING_ADVANCE_DAYS=30
PLATFORM_FEE_PERCENT=10
TAILOR_SHARE_PERCENT=80
AGENT_SHARE_PERCENT=10
